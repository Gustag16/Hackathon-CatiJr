# Copie para .env e ajuste. NÃO commite o .env.
POSTGRES_USER=leilao
POSTGRES_PASSWORD=leilao
POSTGRES_DB=leilao
DATABASE_URL=postgresql://leilao:leilao@localhost:5432/leilao
REDIS_URL=redis://localhost:6379/0

# Django
DJANGO_SECRET_KEY=troque-isto
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Na VM: http://200.18.99.113:<porta-web-do-time>  (o CSRF checa a Origin)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8080
SESSION_COOKIE_AGE_SECONDS=3600

# Fotos: disco local da VM. Em dev, ./media; na VM, o volume Docker (ex.: /srv/media).
MEDIA_ROOT=./media
MEDIA_URL=/media/

# Limites do leilão (RF06: fáceis de alterar para demos curtas)
MIN_START_DELAY_SECONDS=60
MIN_DURATION_SECONDS=60
MAX_DURATION_SECONDS=604800
MAX_START_ADVANCE_SECONDS=2592000
MAX_NAME_LENGTH=100
MAX_DESCRIPTION_LENGTH=2000
MIN_PHOTOS=3
MAX_PHOTOS=8
MAX_PHOTO_BYTES=5242880
ACCEPTED_PHOTO_TYPES=image/jpeg,image/png,image/webp
